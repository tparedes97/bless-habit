<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BlessApplication inicia el SDK de TikTok (Events Manager). -->
    <application
        android:name=".BlessApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- AdMob (anuncios del plan gratis). El valor viene de ADMOB_APP_ID en gradle.properties. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Login nativo con Google: el navegador del sistema redirige aquí de vuelta
                 a la app con un token de un solo uso (ver app.py, /auth/callback con
                 native=1). No tocar sin tocar también la lógica de /auth/callback. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="blesshabit" android:host="auth-callback" />
            </intent-filter>

            <!-- Pago Premium con Paddle: el checkout se abre en el navegador del sistema
                 (ver app.py, /premium/native-checkout) y al terminar vuelve aquí. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="blesshabit" android:host="premium-done" />
            </intent-filter>

            <!-- Botones de las notificaciones: encender / pausar / finalizar el
                 cronómetro y posponer un hábito (ver BlessReminders). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="blesshabit" android:host="timer" />
                <data android:scheme="blesshabit" android:host="postpone" />
            </intent-filter>

        </activity>

        <!-- Recordatorios propios (alarmas exactas que despiertan al teléfono). -->
        <receiver android:name=".BlessReminderReceiver" android:exported="false" />
        <!-- Vuelve a programar los recordatorios al reiniciar, actualizar la app o cambiar la hora. -->
        <receiver android:name=".BlessBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Widget de la pantalla de inicio (progreso de hoy y próximo hábito). -->
        <receiver
            android:name=".BlessWidgetProvider"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bless_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ID de publicidad para AdMob (plan gratis). Play Console lo exige porque la
         declaración de la app dice que usa un ID de publicidad. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!-- Desbloqueo con huella o rostro (plugin @capgo/capacitor-native-biometric). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Crear una alarma en la app Reloj del teléfono para un hábito o tarea
         (BlessDevicePlugin.setAlarm). Es un permiso normal: no pide nada al usuario. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Recordatorios propios (BlessReminders): avisar a la hora exacta, mostrar
         la notificación y volver a programarlos al reiniciar el teléfono. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 11+: para poder abrir la pantalla de "segundo plano / inicio
         automático" de cada marca (ver BlessDevicePlugin). -->
    <queries>
        <package android:name="com.hihonor.systemmanager" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oplus.battery" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.samsung.android.lool" />
        <!-- La app Reloj que recibe "crear alarma". -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
    </queries>

</manifest>
