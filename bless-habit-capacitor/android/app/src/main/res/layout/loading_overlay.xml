<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de carga mientras llega la app desde el servidor. En el plan gratis
     de Render el servidor "duerme" y puede tardar ~30-60 s en despertar: sin
     esto se vería una pantalla en blanco. La quita MainActivity al cargar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bless_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/loading_logo" />

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="28dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/bless_accent" />

        <TextView
            android:id="@+id/loading_slow_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/loading_slow"
            android:textColor="@color/bless_text_dim"
            android:textSize="15sp"
            android:visibility="invisible" />
    </LinearLayout>
</FrameLayout>
